---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
---

<Base title="고객센터 / 문의" desc="폼잇(FormIt) 문의 및 지원 안내.">
  <section class="wrap" style="max-width:760px; padding:48px 20px;">
    <h1>고객센터 / 문의</h1>
    <p class="lead" style="color:var(--muted);">
      결제·다운로드·이용권 관련 문의는 아래로 접수해 주세요. 영업일 기준 24시간 내 응답을 목표로 합니다.
    </p>

    <div class="card" style="margin-top:20px;">
      <h2 style="font-size:18px;">이메일</h2>
      <p><a href={`mailto:${SITE.contactEmail}`} style="color:var(--blue); font-weight:700;">{SITE.contactEmail}</a></p>
    </div>

    <div class="card" style="margin-top:16px;">
      <h2 style="font-size:18px;">자주 묻는 내용</h2>
      <ul style="font-size:15px; color:#334155;">
        <li>결제 후 다운로드 링크가 안 열려요 → 결제 문자(페이앱) 확인 후, 만료되지 않은 링크로 재접속</li>
        <li>링크를 분실했어요 → 구매 시 입력한 휴대폰 번호와 결제 일시를 기재해 메일 문의</li>
        <li>환불을 원해요 → 결제 일시와 사유를 기재해 메일 문의</li>
        <li>파일을 열 수 없어요 → 한글/워드 프로그램으로 DOCX를 열어주세요</li>
      </ul>
    </div>

    <div class="card" style="margin-top:16px;">
      <h2 style="font-size:18px;">운영 정보</h2>
      <p style="font-size:15px; color:#334155;">
        서비스명: {SITE.name} ({SITE.brand})<br />
        도메인: {SITE.domain}<br />
        결제·정산: 페이앱 (주식회사 유디아이디)<br />
        운영자: {SITE.operator}
      </p>
    </div>
  </section>
</Base>