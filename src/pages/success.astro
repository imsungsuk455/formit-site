---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
---

<Base title="다운로드 준비 완료">
  <section class="wrap" style="padding:64px 20px; text-align:center; max-width:640px;">
    <div id="loading">
      <div style="font-size:40px;">⏳</div>
      <h1 style="font-size:26px;">결제 확인 중…</h1>
      <p class="lead">잠시만 기다려주세요. 결제 승인 정보가 도착하면 다운로드 링크를 열어드립니다.</p>
    </div>

    <div id="done" style="display:none;">
      <div style="font-size:44px;">🎉</div>
      <h1 style="font-size:28px;">결제 완료!</h1>
      <p class="lead">
        {SITE.accessDays}일간 전체 이용권이 열렸습니다.<br />
        아래 버튼으로 원하는 파일을 내려받으세요.
      </p>
      <a class="btn" id="libraryLink" href="#" style="font-size:17px; padding:16px 34px;">
        내 다운로드 라이브러리 열기 →
      </a>
      <p style="font-size:13.5px; color:var(--muted); margin-top:16px;">
        이 링크는 {SITE.accessDays}일 뒤 만료됩니다. 분실 시 결제 내역으로 재발급 문의.
      </p>
    </div>

    <div id="fail" style="display:none;">
      <div style="font-size:40px;">🤔</div>
      <h1 style="font-size:24px;">결제 확인이 지연되고 있어요</h1>
      <p class="lead">몇 초 뒤 새로고침하거나, 결제 문자(페이앱)를 확인 후 다시 접속해주세요.</p>
      <button class="btn btn-ghost" onclick="location.reload()">새로고침</button>
    </div>
  </section>

  <script>
    const params = new URLSearchParams(location.search);
    const order = params.get('order') || params.get('var1') || '';
    let tries = 0;

    async function poll() {
      if (!order) {
        document.getElementById('loading').style.display = 'none';
        document.getElementById('fail').style.display = 'block';
        return;
      }
      try {
        const res = await fetch(`/api/order-status?order=${encodeURIComponent(order)}`);
        const data = await res.json();
        if (data.ready && data.token) {
          document.getElementById('loading').style.display = 'none';
          document.getElementById('done').style.display = 'block';
          document.getElementById('libraryLink').href = `/library?t=${encodeURIComponent(data.token)}`;
          return;
        }
      } catch {}
      tries += 1;
      if (tries > 20) {
        document.getElementById('loading').style.display = 'none';
        document.getElementById('fail').style.display = 'block';
        return;
      }
      setTimeout(poll, 1500);
    }
    poll();
  </script>
</Base>
